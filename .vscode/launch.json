{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Express: API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3000"
      }
    }
  ]
}
