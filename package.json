{
  "name": "ponto-server",
  "version": "1.0.0",
  "description": "API Express com CRUD de usuarios, login JWT e PostgreSQL.",
  "main": "src/server.js",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "npm run migrate && nodemon src/server.js",
    "start": "npm run migrate && node src/server.js",
    "migrate": "node src/database/migrate.js"
  },
  "keywords": [
    "express",
    "postgres",
    "jwt",
    "crud"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
